# Copy this file to .env and adjust values before running locally.

# Whisper model size: tiny | base | small | medium | large
# Smaller = faster + less RAM; larger = more accurate
WHISPER_MODEL=base

# Directory where uploaded audio files are saved
AUDIO_DATA_DIR=data

# Max seconds per audio chunk before splitting (for long files)
CHUNK_SECONDS=600

# Overlap between chunks in seconds (prevents word cutoff at boundaries)
CHUNK_OVERLAP=5
